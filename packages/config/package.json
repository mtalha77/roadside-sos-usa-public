    "./tailwind/theme.css": "./tailwind/theme.css",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./site": "./src/site.ts",
    "./logo": "./src/logo.ts",
    "./metadata": "./src/metadata.ts",
    "./brand-guard": "./src/brand-guard.ts",
    "./security": "./src/security.ts",
    "./tokens": "./src/tokens.ts",
    "./color": "./src/color.ts",
    "./theme-colors": "./src/theme-colors.ts",
    "./legal": "./src/legal.ts",
    "./demo": "./src/demo.ts",
    "./demo-fixtures": "./src/demo-fixtures.ts"
