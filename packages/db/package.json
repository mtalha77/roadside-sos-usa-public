{
  "name": "@rsos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./admin": "./src/admin.ts",
    "./claims": "./src/claims.ts",
    "./session": "./src/session.ts",
    "./cookies": "./src/cookies.ts",
    "./public": "./src/public.ts",
    "./key-check": "./src/key-check.ts",
    "./health": "./src/health.ts",
    "./usage": "./src/usage.ts",
    "./tours": "./src/tours.ts",
    "./rate-limit": "./src/rate-limit.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "gen:types": "supabase gen types --remote --lang typescript --schema public > src/database.types.ts"
  },
  "dependencies": {
    "@rsos/config": "workspace:*",
    "@rsos/core": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@rsos/testing": "workspace:*",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
