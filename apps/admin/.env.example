# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are sent to the browser: never put a secret in one.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform (browser key, restricted by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe (read-only reporting of wallets and plans)
STRIPE_SECRET_KEY=

# Twilio (per-market phone numbers are stored in the database, not here)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Resend
RESEND_API_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Deployment environment: production | staging | preview | development
NEXT_PUBLIC_SITE_ENV=development
# Absolute URL of this app (required on production and staging)
NEXT_PUBLIC_SITE_URL=
