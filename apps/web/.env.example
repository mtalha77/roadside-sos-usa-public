# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are sent to the browser: never put a secret in one.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps Platform (browser key, restricted by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Deployment environment: production | staging | preview | development
NEXT_PUBLIC_SITE_ENV=development
# Absolute URL of this app (required on production and staging)
NEXT_PUBLIC_SITE_URL=

# Domain for all brand URLs and emails (defaults to the value in packages/config)
NEXT_PUBLIC_APP_DOMAIN=

# Cloudflare Turnstile (bot protection on forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limiting per IP and per phone)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
